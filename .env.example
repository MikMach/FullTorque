# Variáveis de ambiente. Em local não são necessárias (usa SQLite + DEBUG).
# Em produção, definir no painel do host (Render/Railway/Vercel).

DJANGO_SECRET_KEY=gera-uma-chave-secreta-longa-e-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=o-teu-dominio.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://o-teu-dominio.onrender.com

# Base de dados de produção (Postgres). Sem isto, cai para SQLite.
DATABASE_URL=postgres://utilizador:password@host:5432/nome_da_bd

# Fotos em produção (Cloudflare R2 ou AWS S3). Sem isto, guarda em disco local.
AWS_STORAGE_BUCKET_NAME=fulltorque-media
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=media.o-teu-dominio.pt
# AWS_S3_QUERYSTRING_AUTH=True   # usar URLs assinados se o bucket for privado
